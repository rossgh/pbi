# Copy to .env and fill in. Everything is optional for local dev except SECRET_KEY in production.

SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (defaults to SQLite in ./instance)
# BASE_URL=https://app.yourcompany.com                  (used in emailed links)
# SESSION_COOKIE_SECURE=true                            (set when served over HTTPS)

# --- AI provider (pick one; with none set the app runs in template "demo mode") ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AI_PROVIDER=anthropic   (force a provider: anthropic | openai | azure | demo)

# --- Google sign-in: https://console.cloud.google.com/apis/credentials ---
# Authorized redirect URI: http://localhost:5000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft sign-in: https://entra.microsoft.com → App registrations ---
# Redirect URI (Web): http://localhost:5000/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# --- Email (verification, password reset, invites). Without SMTP, links are shown on screen. ---
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=
# MAIL_FROM=BuildMate AI <no-reply@yourcompany.com>
# DEV_SHOW_EMAIL_LINKS=false
